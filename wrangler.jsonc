{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nabz",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "SEEN"
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    "MAX_NEWS_AGE_MINUTES": "5",
    "MAX_FUTURE_MINUTES": "2",
    "MAX_ITEMS_PER_FEED": "10",
    "MAX_PUBLISH_PER_RUN": "8"
  }
}