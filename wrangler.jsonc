{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nabz",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [
    { "binding": "SEEN", "id": "23528636ed4346468cdea428313b07a8" }
  ],
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "GROUP_CHAT_ID": "-1004352824876",
    "TOPIC_IRAN": "3",
    "TOPIC_MIDDLE_EAST": "4",
    "TOPIC_WORLD": "5",
    "MAX_PUBLISH_PER_RUN": "3"
  }
}
