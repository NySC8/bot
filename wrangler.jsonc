{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nabz",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",

  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },

  "kv_namespaces": [
    {
      "binding": "SEEN"
    }
  ],

  "ai": {
    "binding": "AI",
    "remote": true
  },

  "vars": {
    "GROUP_CHAT_ID": "-1004352824876",
    "TOPIC_IRAN": "3",
    "TOPIC_MIDDLE_EAST": "4",
    "TOPIC_WORLD": "5",

    "MAX_NEWS_AGE_MINUTES": "5",
    "MAX_FUTURE_MINUTES": "2",
    "MAX_ITEMS_PER_FEED": "10",
    "MAX_PUBLISH_PER_RUN": "3"
  }
}
